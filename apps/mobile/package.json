{
  "name": "@interview-coder/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/start-dev-server.mjs --dev-client",
    "android": "node scripts/start-dev-server.mjs --android --dev-client",
    "ios": "node scripts/start-dev-server.mjs --ios --dev-client",
    "devtools": "react-devtools",
    "test": "jest --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "export": "npm run export:android && npm run export:ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@interview-coder/sync-protocol": "1.0.0",
    "@react-native/assets-registry": "0.86.3",
    "expo": "~57.0.19",
    "expo-camera": "~57.0.4",
    "expo-dev-client": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.39.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@react-native/debugger-frontend": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-devtools": "^7.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@interview-coder/sync-protocol$": "<rootDir>/../../packages/sync-protocol/src/index.ts",
      "^@react-native/assets-registry/registry$": "<rootDir>/../../node_modules/@react-native/assets-registry/registry.js",
      "^lucide-react-native$": "<rootDir>/../../node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts",
      "<rootDir>/src/**/__tests__/**/*.test.tsx"
    ]
  }
}
